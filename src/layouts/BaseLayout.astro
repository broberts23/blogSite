---
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import GeometricField from '../components/GeometricField.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import '../styles/geo.css';
import '../styles/nav.css';

interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  current?: string;
  density?: 'default' | 'article';
  geo?: 'full' | 'muted' | 'quiet';
  showProgress?: boolean;
}

const {
  title,
  description = 'Azure, identity security, and automation notes by Ben Roberts.',
  image,
  current = '',
  density = 'default',
  geo = 'full',
  showProgress = false,
} = Astro.props;

const pageTitle = title === 'Ben Roberts' ? 'Ben Roberts — Azure & Identity' : `${title} · benroberts.io`;
const ogImageUrl = image
  ? new URL(typeof image === 'string' ? image : image.src, Astro.site || 'https://benroberts.io').toString()
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07080c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="benroberts.io" href="/rss.xml" />
    <title>{pageTitle}</title>

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title === 'Ben Roberts' ? 'Ben Roberts — Azure & Identity' : title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={density === 'article' ? 'article' : 'website'} />
    <meta property="og:url" content={Astro.url.href} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title === 'Ben Roberts' ? 'Ben Roberts — Azure & Identity' : title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <ClientRouter />
  </head>
  <body>
    <GeometricField intensity={geo} />
    <div class="site-shell">
      <SiteHeader current={current} showProgress={showProgress} />
      <main class="site-main" data-density={density} data-pagefind-body>
        <div class="page-enter">
          <slot />
        </div>
      </main>
      <footer class="site-footer">
        <div class="site-footer-inner">
          <span>© {new Date().getFullYear()} Ben Roberts</span>
          <nav class="site-footer-links" aria-label="Social and feeds">
            <a href="/rss.xml" aria-label="RSS Feed" title="RSS Feed">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
                <circle cx="4" cy="20" r="2" />
                <path d="M4 11a9 9 0 0 1 9 9h-3a6 6 0 0 0-6-6v-3z" />
                <path d="M4 4a16 16 0 0 1 16 16h-3A13 13 0 0 0 4 7V4z" />
              </svg>
            </a>
            <a href="/archive" aria-label="Archive" title="Archive">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M3 3a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3z" />
                <path fill-rule="evenodd" d="M4 8.5A1.5 1.5 0 0 1 5.5 7h13A1.5 1.5 0 0 1 20 8.5V19a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V8.5zM9 11a1 1 0 0 0 0 2h6a1 1 0 1 0 0-2H9z" clip-rule="evenodd" />
              </svg>
            </a>
            <a href="https://github.com/broberts23" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </a>
            <a href="https://www.linkedin.com/in/ben-roberts-280a531b1/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
              </svg>
            </a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
