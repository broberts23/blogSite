---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate, postSlug, isNew } from '../utils/posts';
import { loadCertifications } from '../utils/certs';

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 4);
const newestPost = allPosts[0];
const showNewPost = Boolean(newestPost && isNew(newestPost.data.pubDate));

const activeCerts = loadCertifications()
  .filter((c) => c.status === 'active')
  .sort((a, b) => new Date(b.earned).valueOf() - new Date(a.earned).valueOf());
const certs = activeCerts.slice(0, 4);
const newestCert = activeCerts[0];
const showNewCert = Boolean(newestCert && isNew(new Date(newestCert.earned)));
---

<BaseLayout title="Ben Roberts" current="home" geo="full">
  <section class="hero reveal">
    <p class="eyebrow">Cloud · Identity · Automation</p>
    <h1 class="hero-name">Ben Roberts</h1>
    <p class="hero-role">
      Azure identity security, Entra, PowerShell, and infrastructure automation — written for people who build the lab and ship the fix.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/blog">Read the blog</a>
      <a class="btn" href="/about">About & certifications</a>
    </div>
  </section>

  {
    certs.length > 0 && (
      <section class="section reveal">
        <div class="section-head">
          <h2>Active certifications</h2>
          <a href="/about">View all</a>
        </div>
        <div class="cert-grid cert-row">
          {certs.map((cert) => {
            const isLatest = showNewCert && cert === newestCert;
            return (
              <a
                class:list={['cert-card', { 'is-new': isLatest }]}
                href={cert.credentialUrl || '/about'}
              >
                {isLatest && <span class="new-badge" aria-label="Newly added">New</span>}
                {cert.badgeUrl && (
                  <img
                    class="cert-badge"
                    src={cert.badgeUrl}
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                  />
                )}
                <div class="cert-card-body">
                  <span class="cert-status">{cert.status}</span>
                  <strong>{cert.name}</strong>
                  <span class="issuer">
                    {[cert.issuer, cert.code].filter(Boolean).join(' · ')}
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="section reveal">
    <div class="section-head">
      <h2>Latest posts</h2>
      <a href="/blog">All posts</a>
    </div>
    {
      posts.length === 0 ? (
        <p class="lede">Posts are being migrated. Check back shortly.</p>
      ) : (
        <div class="grid-posts cols-2">
          {posts.map((post) => {
            const isLatest = showNewPost && post === newestPost;
            return (
              <a
                class:list={['card', { 'is-new': isLatest }]}
                href={`/${postSlug(post)}`}
              >
                {isLatest && <span class="new-badge" aria-label="Newly added">New</span>}
                <p class="meta">{formatDate(post.data.pubDate)}</p>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            );
          })}
        </div>
      )
    }
  </section>
</BaseLayout>
