---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Search posts on benroberts.io"
  current="search"
  geo="muted"
>
  <p class="eyebrow">Find</p>
  <h1 class="page-title">Search</h1>
  <p class="lede">Titles, tags, and full post text</p>

  <div class="search-box" id="search">
    <label class="sr-only" for="search-input">Search posts</label>
    <input id="search-input" type="search" placeholder="Search posts…" autocomplete="off" />
    <div id="search-results" aria-live="polite"></div>
  </div>
</BaseLayout>

<script is:inline>
  async function runSearch(query) {
    const resultsEl = document.querySelector('#search-results');
    if (!resultsEl) return;
    if (!query.trim()) {
      resultsEl.innerHTML = '';
      return;
    }
    try {
      const pagefind = await import('/pagefind/pagefind.js');
      await pagefind.options({ excerptLength: 28 });
      const search = await pagefind.search(query);
      const items = await Promise.all(search.results.slice(0, 12).map((r) => r.data()));
      if (!items.length) {
        resultsEl.innerHTML = '<p class="meta">No matches.</p>';
        return;
      }
      resultsEl.innerHTML = items
        .map(
          (item) => `
        <article class="search-result">
          <a href="${item.url}">${item.meta?.title ?? item.url}</a>
          <p>${item.excerpt}</p>
        </article>`,
        )
        .join('');
    } catch {
      resultsEl.innerHTML =
        '<p class="meta">Search index not available yet. Run <code>npm run build</code> first.</p>';
    }
  }

  function setupSearch() {
    const input = document.querySelector('#search-input');
    if (!input || input.dataset.bound === '1') return;
    input.dataset.bound = '1';
    let timer;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => runSearch(input.value), 180);
    });
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q) {
      input.value = q;
      runSearch(q);
    }
  }

  document.addEventListener('astro:page-load', setupSearch);
  setupSearch();
</script>
