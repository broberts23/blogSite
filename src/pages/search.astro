---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Search posts on benroberts.io"
  current="search"
  geo="muted"
>
  <p class="eyebrow">Find</p>
  <h1 class="page-title">Search</h1>
  <p class="lede">Titles, tags, and full post text</p>

  <div class="search-box" id="search">
    <label class="sr-only" for="search-input">Search posts</label>
    <input id="search-input" type="search" placeholder="Search posts…" autocomplete="off" />
    <div id="search-results" aria-live="polite"></div>
  </div>
</BaseLayout>

<script>
  interface PagefindSearchResult {
    data: () => Promise<{
      url: string;
      excerpt?: string;
      meta?: {
        title?: string;
      };
    }>;
  }

  interface PagefindModule {
    options: (opts: { excerptLength?: number }) => Promise<void>;
    search: (query: string) => Promise<{ results: PagefindSearchResult[] }>;
  }

  function getSafeSameOriginUrl(urlStr: string): string | null {
    try {
      const parsed = new URL(urlStr, window.location.origin);
      if (parsed.origin !== window.location.origin) return null;
      if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return null;
      return parsed.pathname + parsed.search + parsed.hash;
    } catch {
      return null;
    }
  }

  function renderExcerpt(excerpt: string, container: HTMLElement): void {
    const template = document.createElement('template');
    template.innerHTML = excerpt;

    function appendSanitized(sourceNode: Node, targetNode: Node): void {
      for (const child of Array.from(sourceNode.childNodes)) {
        if (child.nodeType === Node.TEXT_NODE) {
          targetNode.appendChild(document.createTextNode(child.textContent ?? ''));
        } else if (child.nodeType === Node.ELEMENT_NODE) {
          const el = child as Element;
          if (el.tagName.toLowerCase() === 'mark') {
            const mark = document.createElement('mark');
            appendSanitized(el, mark);
            targetNode.appendChild(mark);
          } else {
            appendSanitized(el, targetNode);
          }
        }
      }
    }

    appendSanitized(template.content, container);
  }

  async function runSearch(query: string): Promise<void> {
    const resultsEl = document.querySelector<HTMLElement>('#search-results');
    if (!resultsEl) return;
    if (!query.trim()) {
      resultsEl.replaceChildren();
      return;
    }
    try {
      const pagefind = (await import(/* @vite-ignore */ '/pagefind/pagefind.js' as string)) as PagefindModule;
      await pagefind.options({ excerptLength: 28 });
      const search = await pagefind.search(query);
      const items = await Promise.all(search.results.slice(0, 12).map((r) => r.data()));
      if (!items.length) {
        const p = document.createElement('p');
        p.className = 'meta';
        p.textContent = 'No matches.';
        resultsEl.replaceChildren(p);
        return;
      }

      const frag = document.createDocumentFragment();
      for (const item of items) {
        const safeUrl = getSafeSameOriginUrl(item.url);
        if (!safeUrl) continue;

        const article = document.createElement('article');
        article.className = 'search-result';

        const link = document.createElement('a');
        link.href = safeUrl;
        link.textContent = item.meta?.title ?? item.url;

        const p = document.createElement('p');
        renderExcerpt(item.excerpt ?? '', p);

        article.append(link, p);
        frag.appendChild(article);
      }

      if (!frag.childNodes.length) {
        const p = document.createElement('p');
        p.className = 'meta';
        p.textContent = 'No matches.';
        resultsEl.replaceChildren(p);
        return;
      }

      resultsEl.replaceChildren(frag);
    } catch {
      const p = document.createElement('p');
      p.className = 'meta';
      p.append('Search index not available yet. Run ');
      const code = document.createElement('code');
      code.textContent = 'npm run build';
      p.append(code, ' first.');
      resultsEl.replaceChildren(p);
    }
  }

  function setupSearch(): void {
    const input = document.querySelector<HTMLInputElement>('#search-input');
    if (!input || input.dataset.bound === '1') return;
    input.dataset.bound = '1';
    let timer: number | undefined;
    input.addEventListener('input', () => {
      if (timer !== undefined) window.clearTimeout(timer);
      timer = window.setTimeout(() => runSearch(input.value), 180);
    });
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q) {
      input.value = q;
      runSearch(q);
    }
  }

  document.addEventListener('astro:page-load', setupSearch);
  setupSearch();
</script>
