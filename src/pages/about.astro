---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadCertifications } from "../utils/certs";
import { formatDate } from "../utils/posts";

const certs = loadCertifications().sort((a, b) => {
  if (a.status === b.status) return 0;
  return a.status === "active" ? -1 : 1;
});
---

<BaseLayout
  title="About"
  description="About Ben Roberts — Azure identity, automation, and security engineer."
  current="about"
  geo="full"
>
  <p class="eyebrow">About</p>
  <h1 class="page-title">Ben Roberts</h1>
  <p class="lede">
    A blog for all things Azure! Whether you're a developer or IT pro, explore
    tips, trends, and hands-on guides to optimize and transform your workflow
    with Microsoft Azure's powerful capabilities. Join me while I learn new
    features and technologies from code to infrastructure.
    <br />
    <br />
    I write about Azure, Entra, Identity Security, Python, PowerShell, and the infrastructure
    patterns that keep labs disposable and production systems honest.
    <br />
    <br />
    Advanced engineering at the intersection of Cloud Architecture, Identity Security,
    and AI Automation. Explore deep-dives, hands-on architecture guides, and custom
    tooling designed to secure and automate the enterprise. My goal is to help you
    build secure, scalable, and efficient systems.
  </p>

  <section class="section reveal">
    <div class="section-head">
      <h2>Certifications</h2>
    </div>
    <div class="cert-grid">
      {
        certs.map((cert) => {
          const Tag = cert.credentialUrl ? "a" : "div";
          const attrs = cert.credentialUrl
            ? {
                href: cert.credentialUrl,
                rel: "noopener noreferrer",
                target: "_blank",
              }
            : {};
          const expiredDate = cert.expired || cert.expires;
          return (
            <Tag class="cert-card" {...attrs}>
              {cert.badgeUrl && (
                <img
                  class="cert-badge"
                  src={cert.badgeUrl}
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                />
              )}
              <div class="cert-card-body">
                <span
                  class={`cert-status ${cert.status === "active" ? "" : "inactive"}`}
                >
                  {cert.status}
                </span>
                <strong>{cert.name}</strong>
                <span class="issuer">
                  {[cert.issuer, cert.code].filter(Boolean).join(" · ")}
                </span>
                <span class="meta">
                  {
                    cert.status === "inactive" ? (
                      expiredDate ? (
                        `Expired ${formatDate(new Date(expiredDate))}`
                      ) : (
                        `Earned ${formatDate(new Date(cert.earned))}`
                      )
                    ) : (
                      <>
                        Earned {formatDate(new Date(cert.earned))}
                        {cert.expires
                          ? ` · Expires ${formatDate(new Date(cert.expires))}`
                          : ""}
                      </>
                    )
                  }
                </span>
              </div>
            </Tag>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
