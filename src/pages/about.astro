---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadCertifications } from '../utils/certs';
import { formatDate } from '../utils/posts';

const certs = loadCertifications();
---

<BaseLayout
  title="About"
  description="About Ben Roberts — Azure identity engineer and certifications."
  current="about"
  geo="full"
>
  <p class="eyebrow">About</p>
  <h1 class="page-title">Ben Roberts</h1>
  <p class="lede">
    I write about Azure identity, Entra, PowerShell, and the infrastructure patterns that keep labs
    disposable and production systems honest. This site replaces the Hashnode blog with a static
    home that treats PowerShell as a first-class language.
  </p>

  <section class="section reveal">
    <div class="section-head">
      <h2>Certifications</h2>
    </div>
    <div class="cert-grid">
      {
        certs.map((cert) => {
          const Tag = cert.credentialUrl ? 'a' : 'div';
          const attrs = cert.credentialUrl
            ? { href: cert.credentialUrl, rel: 'noopener noreferrer', target: '_blank' }
            : {};
          return (
            <Tag class="cert-card" {...attrs}>
              {cert.badgeUrl && (
                <img
                  class="cert-badge"
                  src={cert.badgeUrl}
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                />
              )}
              <div class="cert-card-body">
                <span class={`cert-status ${cert.status === 'active' ? '' : 'inactive'}`}>
                  {cert.status}
                </span>
                <strong>{cert.name}</strong>
                <span class="issuer">
                  {[cert.issuer, cert.code].filter(Boolean).join(' · ')}
                </span>
                <span class="meta">
                  Earned {formatDate(new Date(cert.earned))}
                  {cert.expires ? ` · Expires ${formatDate(new Date(cert.expires))}` : ''}
                </span>
              </div>
            </Tag>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
