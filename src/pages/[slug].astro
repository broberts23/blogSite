---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate, postSlug, estimateReadingTime } from '../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = estimateReadingTime(post.body ?? '');
const slug = postSlug(post);
const heroImage = post.data.heroImage;
const transitionName = `hero-${slug.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={heroImage}
  current="blog"
  density="article"
  geo="quiet"
  showProgress={true}
>
  <article>
    {
      heroImage ? (
        <header class="article-hero">
          <div class="article-hero-media">
            <Image
              src={heroImage}
              alt={post.data.title}
              width={1200}
              height={675}
              class="article-hero-img"
              style={`view-transition-name: ${transitionName};`}
              loading="eager"
            />
            <div class="article-hero-scrim" />
          </div>

          <div class="article-hero-content">
            <p class="meta article-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span class="meta-sep">·</span>
              <span>{minutes} min read</span>
            </p>
            <h1 class="page-title article-title">{post.data.title}</h1>
          </div>

          {post.data.tags.length > 0 && (
            <ul class="tag-list article-tags">
              {post.data.tags.map((tag) => (
                <li>
                  <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </header>
      ) : (
        <header class="article-hero article-hero-text">
          <p class="meta article-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span class="meta-sep">·</span>
            <span>{minutes} min read</span>
          </p>
          <h1 class="page-title article-title">{post.data.title}</h1>
          {post.data.tags.length > 0 && (
            <ul class="tag-list article-tags">
              {post.data.tags.map((tag) => (
                <li>
                  <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </header>
      )
    }

    <div class="prose" style="margin-top: 2rem;">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  let mermaidReady = false;

  const MERMAID_PAD = 12;
  const MERMAID_MAX_SCALE = 2.5;
  const MERMAID_ZOOM_STEP = 1.2;
  const MERMAID_PAN_STEP = 48;

  function parseViewBox(svg: SVGSVGElement): { width: number; height: number } | null {
    const vb = svg.getAttribute('viewBox');
    if (vb) {
      const parts = vb.trim().split(/[\s,]+/).map(Number);
      if (parts.length === 4 && parts.every((n) => Number.isFinite(n)) && parts[2] > 0 && parts[3] > 0) {
        return { width: parts[2], height: parts[3] };
      }
    }

    const attrW = parseFloat(svg.getAttribute('width') ?? '');
    const attrH = parseFloat(svg.getAttribute('height') ?? '');
    if (Number.isFinite(attrW) && Number.isFinite(attrH) && attrW > 0 && attrH > 0) {
      return { width: attrW, height: attrH };
    }

    return null;
  }

  function sizeMermaidSvg(svg: SVGSVGElement): { width: number; height: number } | null {
    const size = parseViewBox(svg);
    if (!size) return null;

    svg.setAttribute('width', String(size.width));
    svg.setAttribute('height', String(size.height));
    svg.style.width = `${size.width}px`;
    svg.style.height = `${size.height}px`;
    svg.style.maxWidth = 'none';
    return size;
  }

  function enhanceMermaidDiagram(pre: HTMLElement) {
    if (pre.classList.contains('mermaid-error')) return;
    if (pre.closest('.mermaid-viewport')) return;

    const svg = pre.querySelector('svg');
    if (!(svg instanceof SVGSVGElement)) return;

    const sized = sizeMermaidSvg(svg);
    if (!sized) return;
    const { width: diagramWidth, height: diagramHeight } = sized;

    const viewport = document.createElement('div');
    viewport.className = 'mermaid-viewport';
    viewport.tabIndex = 0;
    viewport.setAttribute('role', 'group');
    viewport.setAttribute('aria-label', 'Diagram: drag to pan, scroll to zoom');

    const canvas = document.createElement('div');
    canvas.className = 'mermaid-canvas';

    const controls = document.createElement('div');
    controls.className = 'mermaid-controls';
    controls.innerHTML = `
      <button type="button" class="mermaid-control" data-action="zoom-out" aria-label="Zoom out">−</button>
      <button type="button" class="mermaid-control" data-action="zoom-in" aria-label="Zoom in">+</button>
      <button type="button" class="mermaid-control" data-action="reset" aria-label="Reset view">↺</button>
    `;

    canvas.appendChild(svg);
    viewport.appendChild(canvas);
    viewport.appendChild(controls);
    pre.replaceWith(viewport);

    let scale = 1;
    let tx = MERMAID_PAD;
    let ty = MERMAID_PAD;
    let defaultScale = 1;
    let defaultTx = MERMAID_PAD;
    let defaultTy = MERMAID_PAD;
    let minScale = 0.1;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let pinchDist = 0;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function applyTransform() {
      canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      if (reduceMotion) {
        canvas.style.transition = 'none';
      }
    }

    function fitScale(): number {
      const rect = viewport.getBoundingClientRect();
      const availW = Math.max(rect.width - MERMAID_PAD * 2, 1);
      const availH = Math.max(rect.height - MERMAID_PAD * 2, 1);
      return Math.min(availW / diagramWidth, availH / diagramHeight, 1);
    }

    function computeDefaultView() {
      const rect = viewport.getBoundingClientRect();
      defaultScale = 1;
      defaultTy = MERMAID_PAD;
      if (diagramWidth * defaultScale < rect.width) {
        defaultTx = (rect.width - diagramWidth * defaultScale) / 2;
      } else {
        defaultTx = MERMAID_PAD;
      }
      minScale = Math.min(fitScale(), 1);
    }

    function resetView() {
      computeDefaultView();
      scale = defaultScale;
      tx = defaultTx;
      ty = defaultTy;
      applyTransform();
    }

    function zoomAt(clientX: number, clientY: number, nextScale: number) {
      const clamped = Math.min(MERMAID_MAX_SCALE, Math.max(minScale, nextScale));
      if (clamped === scale) return;

      const rect = viewport.getBoundingClientRect();
      const px = clientX - rect.left;
      const py = clientY - rect.top;
      const worldX = (px - tx) / scale;
      const worldY = (py - ty) / scale;

      scale = clamped;
      tx = px - worldX * scale;
      ty = py - worldY * scale;
      applyTransform();
    }

    function zoomBy(factor: number) {
      const rect = viewport.getBoundingClientRect();
      zoomAt(rect.left + rect.width / 2, rect.top + rect.height / 2, scale * factor);
    }

    resetView();

    viewport.addEventListener('pointerdown', (event) => {
      if ((event.target as HTMLElement).closest('.mermaid-controls')) return;
      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;
      viewport.classList.add('is-dragging');
      viewport.setPointerCapture(event.pointerId);
    });

    viewport.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      tx += event.clientX - lastX;
      ty += event.clientY - lastY;
      lastX = event.clientX;
      lastY = event.clientY;
      applyTransform();
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      viewport.classList.remove('is-dragging');
      if (viewport.hasPointerCapture(event.pointerId)) {
        viewport.releasePointerCapture(event.pointerId);
      }
    };

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);

    viewport.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault();
        const factor = event.deltaY < 0 ? MERMAID_ZOOM_STEP : 1 / MERMAID_ZOOM_STEP;
        zoomAt(event.clientX, event.clientY, scale * factor);
      },
      { passive: false },
    );

    viewport.addEventListener(
      'touchstart',
      (event) => {
        if (event.touches.length === 2) {
          const [a, b] = [event.touches[0], event.touches[1]];
          pinchDist = Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
        }
      },
      { passive: true },
    );

    viewport.addEventListener(
      'touchmove',
      (event) => {
        if (event.touches.length !== 2) return;
        event.preventDefault();
        const [a, b] = [event.touches[0], event.touches[1]];
        const dist = Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
        if (pinchDist > 0) {
          const midX = (a.clientX + b.clientX) / 2;
          const midY = (a.clientY + b.clientY) / 2;
          zoomAt(midX, midY, scale * (dist / pinchDist));
        }
        pinchDist = dist;
      },
      { passive: false },
    );

    viewport.addEventListener(
      'touchend',
      () => {
        pinchDist = 0;
      },
      { passive: true },
    );

    controls.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
      if (!button) return;
      const action = button.dataset.action;
      if (action === 'zoom-in') zoomBy(MERMAID_ZOOM_STEP);
      else if (action === 'zoom-out') zoomBy(1 / MERMAID_ZOOM_STEP);
      else if (action === 'reset') resetView();
    });

    viewport.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        tx += MERMAID_PAN_STEP;
        applyTransform();
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        tx -= MERMAID_PAN_STEP;
        applyTransform();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        ty += MERMAID_PAN_STEP;
        applyTransform();
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        ty -= MERMAID_PAN_STEP;
        applyTransform();
      } else if (event.key === '+' || event.key === '=') {
        event.preventDefault();
        zoomBy(MERMAID_ZOOM_STEP);
      } else if (event.key === '-' || event.key === '_') {
        event.preventDefault();
        zoomBy(1 / MERMAID_ZOOM_STEP);
      } else if (event.key === '0') {
        event.preventDefault();
        resetView();
      }
    });

    window.addEventListener('resize', () => {
      computeDefaultView();
      minScale = Math.min(fitScale(), 1);
      if (scale < minScale) {
        scale = minScale;
        applyTransform();
      }
    });
  }

  async function renderMermaidDiagrams() {
    const nodes = [
      ...document.querySelectorAll<HTMLElement>('pre.mermaid:not([data-processed])'),
    ];
    if (nodes.length === 0) return;

    try {
      const { default: mermaid } = await import('mermaid');

      if (!mermaidReady) {
        mermaid.initialize({
          startOnLoad: false,
          theme: 'dark',
          securityLevel: 'loose',
          fontFamily: 'Sora, "Segoe UI", system-ui, sans-serif',
          flowchart: { useMaxWidth: false },
          sequence: { useMaxWidth: false },
          themeVariables: {
            darkMode: true,
            background: '#0c0e14',
            primaryColor: '#101218',
            primaryTextColor: '#e8eaef',
            primaryBorderColor: 'rgba(255, 255, 255, 0.08)',
            secondaryColor: '#161922',
            tertiaryColor: '#07080c',
            lineColor: '#9aa3b5',
            textColor: '#e8eaef',
            mainBkg: '#101218',
            nodeBorder: 'rgba(255, 255, 255, 0.08)',
            clusterBkg: '#0c0e14',
            clusterBorder: 'rgba(61, 214, 245, 0.35)',
            titleColor: '#e8eaef',
            edgeLabelBackground: '#101218',
            actorBkg: '#101218',
            actorBorder: 'rgba(61, 214, 245, 0.4)',
            actorTextColor: '#e8eaef',
            actorLineColor: '#9aa3b5',
            signalColor: '#e8eaef',
            signalTextColor: '#e8eaef',
            labelBoxBkgColor: '#101218',
            labelBoxBorderColor: 'rgba(255, 255, 255, 0.08)',
            labelTextColor: '#e8eaef',
            loopTextColor: '#e8eaef',
            noteBkgColor: '#161922',
            noteTextColor: '#e8eaef',
            noteBorderColor: 'rgba(61, 214, 245, 0.35)',
            activationBkgColor: 'rgba(61, 214, 245, 0.14)',
            activationBorderColor: '#3dd6f5',
            sequenceNumberColor: '#07080c',
          },
        });
        mermaidReady = true;
      }

      await mermaid.run({ nodes });

      for (const node of nodes) {
        if (node.isConnected) enhanceMermaidDiagram(node);
      }
    } catch (error) {
      console.error('Mermaid render failed:', error);
      for (const node of nodes) {
        node.removeAttribute('data-processed');
        node.classList.add('mermaid-error');
      }
    }
  }

  document.addEventListener('astro:page-load', renderMermaidDiagrams);
  renderMermaidDiagrams();
</script>

<style>
  .article-hero {
    display: flex;
    flex-direction: column;
    margin-bottom: 2.25rem;
  }

  .article-hero-media {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    max-height: 28rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    box-shadow:
      0 12px 36px rgba(0, 0, 0, 0.65),
      0 0 20px -4px rgba(61, 214, 245, 0.12);
  }

  .article-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Soft multi-stop bottom vignette blending image into page */
  .article-hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(7, 8, 12, 0) 0%,
      rgba(7, 8, 12, 0.15) 50%,
      rgba(7, 8, 12, 0.75) 82%,
      rgba(7, 8, 12, 0.96) 100%
    );
  }

  .article-hero-content {
    position: relative;
    z-index: 2;
    margin-top: -3.75rem;
    padding: 1.5rem 1.25rem 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(7, 8, 12, 0.85) 20%,
      #07080c 60%
    );
    backdrop-filter: blur(4px);
    border-radius: var(--radius);
  }

  .article-meta {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .meta-sep {
    opacity: 0.6;
  }

  .article-title {
    margin: 0.4rem 0 0;
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    line-height: 1.15;
    color: var(--text);
  }

  .article-tags {
    margin-top: 1.25rem;
    padding-left: 1.25rem;
  }

  .article-hero-text .article-tags {
    padding-left: 0;
  }

  @media (max-width: 640px) {
    .article-hero-media {
      aspect-ratio: 16 / 10;
      max-height: 18rem;
    }

    .article-hero-content {
      margin-top: 0.75rem;
      padding: 0;
      background: none;
      backdrop-filter: none;
    }

    .article-tags {
      padding-left: 0;
    }
  }
</style>
