---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../utils/posts';

const all = await getPublishedPosts();
const pageSize = 10;
const totalPages = Math.max(1, Math.ceil(all.length / pageSize));
const page = 1;
const posts = all.slice(0, pageSize);
---

<BaseLayout
  title="Blog"
  description="All posts on Azure, identity security, and automation."
  current="blog"
  geo="muted"
>
  <p class="eyebrow">Writing</p>
  <h1 class="page-title">Blog</h1>
  <p class="lede">Practical notes on Entra, Azure, PowerShell, and the labs behind them.</p>

  <div class="grid-posts cols-2">
    {
      posts.map((post) => (
        <PostCard post={post} showTags={true} class="reveal" />
      ))
    }
  </div>

  {
    totalPages > 1 && (
      <nav class="pagination" aria-label="Blog pagination">
        <span class="meta">
          Page {page} of {totalPages}
        </span>
        <a class="btn" href="/blog/2">
          Older posts
        </a>
      </nav>
    )
  }
</BaseLayout>
