{
  "name": "blogsite",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node -e \"import('node:fs').then(fs => fs.cpSync('dist/pagefind', 'public/pagefind', { recursive: true }))\"",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "astro": "^7.3.3",
    "js-yaml": "^4.1.0",
    "mermaid": "^12.2.0",
    "pagefind": "^1.4.0",
    "rehype-external-links": "^3.0.0",
    "rehype-sanitize": "^6.0.0",
    "threejs-components": "^0.0.19"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "undici": "8.12.3",
    "zod": "4.6.7",
    "devalue": "5.9.4"
  }
}
